# Google API key: only required for explicitly approved image/video generation
GOOGLE_API_KEY=
# Select the model ID that is available for your account/API surface
VEO_MODEL=veo-3.1-generate-preview
IMAGE_MODEL=gemini-3.1-flash-image
TTS_VOICE=en-US-GuyNeural

# Optional Vertex AI Lyria music generation (requires Google Cloud ADC/service account)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
SCRIPT_MODEL=gemini-3.1-flash-lite
